# systemd EnvironmentFile —— 只放运行期需要的环境变量
#
# 不带 /usr/local/netsups/bin：避免 shell 又找到同名启动器造成递归
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# 代码目录在 ProtectSystem=strict 下是只读的，禁止 Python 往里写 __pycache__
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
PYTHONIOENCODING=UTF-8

# 数据与配置：物理位置 /Volume<N>/@apps/netsups/，升级与重装都不会动
NETSUPS_DATA=/usr/local/netsups/data

# 平台代理（TOSDaemon）以 root 连 socket，按规范给 0660
NETSUPS_SOCK_MODE=0660

# 经平台代理进来的请求必须带 Cookie + X-Csrf-Token（TOS 规范 8.10）。
# 仅本地直连端口调试时才需要临时改成 0。
NETSUPS_REQUIRE_CSRF=1
